# Raspberry Pi 5 kiosk — copy to /etc/fh6parse-kiosk.ini or next to the app.
# GPIO numbers are BCM (same pins as Pi 3/4). Buttons: momentary to GND.
# KY-040 encoder: CLK / DT; shaft switch unused. Pi 5 needs lgpio, not RPi.GPIO.
# Updates are not configured here. Git checkout + on-screen UPDATE: see
# packaging/LINUX-KIOSK.md §8 (fh6parse 1.4.0). This file is never overwritten.

[kiosk]
width = 600
height = 800
fullscreen = true
idle_seconds = 60
# Screen language: pl (default on the kiosk) or en. Change in settings (F2 / mouse).
# language = pl
# Windows GUI also stores last_nc_dir, last_out_dir, last_paper (a4 or 80mm)
# in this file and in ~/.config/fh6parse/ui.ini.

encoder_clk = 17
encoder_dt = 27
encoder_swap = false
# gpiozero ticks from one tooth valley (rest) to the next. Highlight
# changes at half a tooth so a wiggle at rest does not skip files.
# 1 = every tick (no dead zone). Typical KY-040 is 2 or 4.
encoder_steps = 1
button_full = 22
button_min = 23

printer_device = /dev/usb/lp0
# Optional CUPS name — only if /dev/usb/lp0 is missing. Leave empty on the shop Pi.
# printer_queue = munbyn

usb_poll_ms = 500
scan_depth = 1
extensions = .nc,.tap
# extra_roots = /home/kiosk/nc-samples

# USB stick is searched first (folder of the .nc + subfolders). Stick wins.
# Company STEP folders below are optional fallback. Comma or path-separator.
# Matching starts at the shared prefix of the NC name / program title.
# G-code (REV 3) / (Rewizja: 02) / trailing -0 or _Rev03 must match the
# model revision. If the NC has no rev, the latest matching .stp is used.
# D0134078.nc  ->  D0134078_Rev03.stp  (not D0134079_…)
# SE0241282.nc with O-title SE0241282-0  ->  SE0241282-0.stp
# Missing models never block print. CAD extra: pip install -e '.[models]'
# model_roots = /mnt/cad/stp,/mnt/cad/archive

# Mill used for programmed cycle time. Pick in settings (F2) or here.
# [machine.default] is built in (20 m/min, 0 s tool change) if omitted.
# machine = vf-4ss
#
# [machine.vf-4ss]
# name = Haas VF-4SS
# rapid_mm_min = 25400
# rotary_deg_min = 5400
# tool_change_s = 2.8
#
# [machine.vf-2]
# name = Haas VF-2
# rapid_mm_min = 25400
# rotary_deg_min = 5400
# tool_change_s = 8
