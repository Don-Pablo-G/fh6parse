# Raspberry Pi 3 kiosk — copy to /etc/fh6parse-kiosk.ini or next to the app.
# GPIO numbers are BCM. Buttons: momentary to GND (internal pull-up).
# KY-040 encoder: CLK / DT; shaft switch unused.
# Updates are not configured here. Git checkout + on-screen UPDATE: see
# packaging/LINUX-KIOSK.md §8 (fh6parse 1.3.2). This file is never overwritten.

[kiosk]
width = 600
height = 800
fullscreen = true
idle_seconds = 60

encoder_clk = 17
encoder_dt = 27
encoder_swap = false
button_full = 22
button_min = 23

printer_queue = munbyn
printer_device = /dev/usb/lp0

usb_poll_ms = 500
scan_depth = 1
extensions = .nc,.tap
# extra_roots = /home/pi/nc-samples

# Company STEP folders (searched with subfolders). Comma or path-separator.
# Matching starts at the shared prefix of the NC name / program title.
# G-code (REV 3) / (Rewizja: 02) / trailing -0 or _Rev03 must match the
# model revision. If the NC has no rev, the latest matching .stp is used.
# D0134078.nc  ->  D0134078_Rev03.stp  (not D0134079_…)
# SE0241282.nc with O-title SE0241282-0  ->  SE0241282-0.stp
# Missing models never block print. CAD extra: pip install -e '.[models]'
# model_roots = /mnt/cad/stp,/mnt/cad/archive
