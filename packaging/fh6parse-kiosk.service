# fh6parse 1.3.2 shop update (git checkout): kiosk shows UPDATE if origin is
# ahead, or: python3 -m fh6parse --update
# pi needs NOPASSWD for: /usr/bin/systemctl restart fh6parse-kiosk
# (see packaging/LINUX-KIOSK.md §3.2 and §8). Otherwise: sudo systemctl restart …
# STEP folders: set model_roots in /etc/fh6parse-kiosk.ini; mount the share
# before this unit starts (fstab). CAD extra is pip install -e '.[models]'.

[Unit]
Description=fh6parse CNC USB kiosk
After=graphical.target cups.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 -m fh6parse --kiosk --config /etc/fh6parse-kiosk.ini
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
