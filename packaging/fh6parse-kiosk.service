[Unit]
Description=fh6parse CNC USB kiosk
After=graphical.target cups.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 -m fh6parse --kiosk --config /etc/fh6parse-kiosk.ini
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
