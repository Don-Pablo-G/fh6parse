# syntax=docker/dockerfile:1
# Raspberry Pi (armv7 / aarch64) one-file binary. Build with docker buildx:
#   docker buildx build --platform linux/arm/v7 -f packaging/Dockerfile.raspberry \
#     --output type=local,dest=dist/raspberry-armv7 .
FROM debian:bookworm-slim AS build

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-tk \
        python3-dev \
        python3-setuptools \
        gcc \
        make \
        libffi-dev \
        binutils \
        && rm -rf /var/lib/apt/lists/*

# gpiozero always. lgpio (Pi 5) and RPi.GPIO (Pi 3/4) are best-effort; Debian
# bookworm has no python3-lgpio package. Shop GPIO on Pi 5 is the git checkout.
RUN python3 -m pip install --no-cache-dir pyinstaller gpiozero
RUN python3 -m pip install --no-cache-dir lgpio || true
RUN python3 -m pip install --no-cache-dir RPi.GPIO || true

WORKDIR /src
COPY pyproject.toml /src/pyproject.toml
COPY fh6parse /src/fh6parse
COPY packaging /src/packaging

RUN python3 -m PyInstaller --noconfirm --clean \
        --distpath /out \
        --workpath /tmp/pyi-work \
        /src/packaging/fh6parse.spec \
        && chmod +x /out/fh6parse \
        && python3 -c "import pathlib; p=pathlib.Path('/out/fh6parse'); assert p.is_file() and p.stat().st_size>0"

FROM scratch
COPY --from=build /out/fh6parse /fh6parse
